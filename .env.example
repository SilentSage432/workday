NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required only when privileged external-provider credential custody
# or Google Calendar connection is invoked. Ordinary Orient use does not require these.
# Never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# EXTERNAL_CREDENTIALS_ENCRYPTION_KEY=
# EXTERNAL_CREDENTIALS_ENCRYPTION_KEY must be the standard base64 encoding of exactly 32
# cryptographically random bytes for AES-256-GCM. Do not derive from a password string.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_OAUTH_REDIRECT_URI example (production):
#   https://orient-cyan.vercel.app/api/external/google/callback
# GOOGLE_OAUTH_REDIRECT_URI example (local):
#   http://localhost:3000/api/external/google/callback
